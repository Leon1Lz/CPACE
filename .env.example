# ============================================================
# CPACE Learning Portal — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Pooled connection string (via PgBouncer) — used by the app
DATABASE_URL="postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true"
# Direct connection string — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.<project>:<password>@<host>:5432/postgres"

# ── NextAuth.js ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<generate-a-random-secret>"
NEXTAUTH_URL="http://localhost:3000"

# ── Pusher Channels (WebSocket / Real-time) ─────────────────
# Get these from your App Keys tab: https://dashboard.pusher.com
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# ── Email (SMTP or Resend) ──────────────────────────────────
# If SMTP_HOST is set, emails are sent via SMTP.
# Otherwise if RESEND_API_KEY is set, the Resend API is used.
# If neither is configured, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Contact and newsletter forms also accept SMTP_PASS as an alias.
SMTP_SECURE=false
EMAIL_FROM=onboarding@resend.dev

# Public contact/newsletter form delivery (SMTP required)
CONTACT_EMAIL_TO=info@cpaceph.com
CONTACT_EMAIL_FROM=
SEND_AUTO_REPLY=false

# Optional: Resend API key (fallback when SMTP is not configured)
# RESEND_API_KEY=
